# ─────────────────────────────────────────────────────────────
# CyberSentinel v2 — Environment Variables
# Copy to .env and fill in your keys
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Threat Intel APIs ─────────────────────────────────────────
URLSCAN_API_KEY=                  # https://urlscan.io/user/signup (free)
VIRUSTOTAL_API_KEY=               # https://www.virustotal.com/gui/join-us (free)
ABUSEIPDB_API_KEY=                # https://www.abuseipdb.com/register (free, NEW in v2)

# ── Storage ───────────────────────────────────────────────────
CYBERSENTINEL_DB=data/cybersentinel.db    # SQLite path (local)
# For PostgreSQL: postgresql+asyncpg://user:pass@host/dbname

# ── Cache ─────────────────────────────────────────────────────
REDIS_URL=                        # redis://localhost:6379/0 (optional, falls back to memory)

# ── Security ──────────────────────────────────────────────────
API_KEYS=change-me-key-1,change-me-key-2  # Comma-separated valid API keys (leave empty for open access)
RATE_LIMIT_PER_MIN=20             # Max requests per API key per minute

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=*                 # Production: set to https://your-domain.com

# ── Notifications (optional) ──────────────────────────────────
SLACK_WEBHOOK_URL=                # https://hooks.slack.com/services/... (for CRITICAL/HIGH alerts)
SLACK_ALERT_LEVELS=CRITICAL,HIGH  # Which levels trigger Slack alerts

# ── App ───────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000  # Used in Slack alert links
